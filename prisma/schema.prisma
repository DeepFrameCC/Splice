generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  CLIENT
  TEAM
  ADMIN
}

enum Founder {
  PAPI
  LOUISIA
  TY
}

enum MediaType {
  PHOTO
  VIDEO
}

enum DevisStatus {
  ATTENTE
  VALIDE
  REFUSE
  PAYE
}

enum FactureStatus {
  EMISE
  PAYEE
  ANNULEE
}

enum ContratStatus {
  A_VENIR
  EN_COURS
  FINI
}

enum CounterType {
  DEVIS
  FACTURE
  CONTRAT
}

enum DevisType {
  ABONNEMENT
  PACK_PARTICULIER
  FORMULE_BIENVENUE
}

enum DureeTournage {
  DEMI_JOURNEE
  JOURNEE
  DEUX_JOURNEES
}

enum UsageType {
  ORGANIQUE
  ADS_SOCIAL
  ADS_GOOGLE
}

enum DelaiLivraison {
  STANDARD
  ETENDU
  EXPRESS_48H
}

enum VilleDepart {
  TOURS
  ORLEANS
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_VERIFIED
  DEVIS_CREATED
  DEVIS_UPDATED
  DEVIS_DELETED
  FACTURE_CREATED
  CONTRAT_CREATED
  CONTRAT_UPDATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ADMIN_ACTION
  SETTINGS_UPDATED
  CONSENT_UPDATED
}

enum NotificationType {
  DEVIS_STATUS
  FACTURE_EMISE
  CONTRAT_SIGNE
  PAYMENT_CONFIRM
  SYSTEM
}

enum ConsentType {
  COOKIES_ESSENTIELS
  COOKIES_ANALYTICS
  NEWSLETTER
  DONNEES_PERSONNELLES
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── User & Auth ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(CLIENT)
  pseudo        String    @unique
  emailVerified DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  hasUsedFormuleBienvenue Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  sessions      Session[]
  likes         Like[]
  devis         Devis[]
  factures      Facture[]
  contrats      Contrat[]
  mediasMontes  Media[]        @relation("Monteur")
  auditLogs     AuditLog[]
  notifications Notification[]
  consents      ConsentLog[]
  reviews       Review[]
  blogPosts     BlogPost[] @relation("BlogAuthor")

  @@index([email])
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  prenom        String?
  nom           String?
  nomEntreprise String?
  adresse       String?
  codePostal    String?
  ville         String?
  pays          String  @default("France")
  tel           String?
  age           Int?
  avatarUrl     String?
  bio           String?

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ─── Media & Gallery ────────────────────────────────────────

model Media {
  id           String    @id @default(cuid())
  type         MediaType
  url          String
  thumbnailUrl String?
  previewUrl   String?
  title        String
  description  String?
  materiel     String[]
  prixEstime   Int
  owner        Founder
  category     String?
  client       String?
  duration     String?
  monteurId    String?
  monteur      User?     @relation("Monteur", fields: [monteurId], references: [id])
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())

  likes        Like[]
}

model Like {
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
}

// ─── Business: Devis, Facture, Contrat ──────────────────────

model Counter {
  annee        Int
  type         CounterType
  lastSequence Int         @default(0)

  @@id([annee, type])
}

model Devis {
  id              String         @id @default(cuid())
  numero          String         @unique
  annee           Int
  sequence        Int
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  status          DevisStatus    @default(ATTENTE)
  chefDeProjet    Founder
  devisType       DevisType      @default(PACK_PARTICULIER)
  pack            String
  planAbonnement  String?
  billingCycle    String?
  duree           DureeTournage  @default(DEMI_JOURNEE)
  usage           UsageType      @default(ORGANIQUE)
  delai           DelaiLivraison @default(STANDARD)
  villeDepart     VilleDepart    @default(TOURS)
  distanceKm      Int            @default(0)
  videosSupp      Int            @default(0)
  videos3D        Int            @default(0)
  motionDesign    Boolean        @default(false)
  montageExpress  Boolean        @default(false)
  introAnimeeSec  Int?
  nbFormat916     Int            @default(0)
  nbFormat169     Int            @default(0)
  nomEntreprise   String
  nomContact      String
  emailContact    String
  telContact      String
  lieuTournage    String
  dateTournage    DateTime?
  remarques       String?
  lines           Json
  totalHT         Int
  acompteRate     Int            @default(30)
  acompteAmount   Int
  acomptePaid     Boolean        @default(false)
  pdfUrl          String?
  stripeSession   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  facture         Facture?
  contrat         Contrat?
}

model Facture {
  id        String        @id @default(cuid())
  numero    String        @unique
  devisId   String        @unique
  devis     Devis         @relation(fields: [devisId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  status    FactureStatus @default(EMISE)
  pdfUrl    String?
  createdAt DateTime      @default(now())
}

model Contrat {
  id        String        @id @default(cuid())
  numero    String        @unique
  annee     Int
  sequence  Int
  devisId   String        @unique
  devis     Devis         @relation(fields: [devisId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  status    ContratStatus @default(A_VENIR)
  pdfUrl    String?
  dateDebut DateTime?
  dateFin   DateTime?
  createdAt DateTime      @default(now())
}

// ─── Reviews & Avis ─────────────────────────────────────────

model Avis {
  id         String   @id @default(cuid())
  auteurNom  String
  contenu    String
  note       Int
  approuve   Boolean  @default(false)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contenu   String   @db.Text
  note      Int
  approuve  Boolean  @default(false)
  reponse   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Audit & Security ───────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  target    String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Notifications ──────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  href      String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ─── RGPD Consent Tracking ──────────────────────────────────

model ConsentLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  consentType ConsentType
  granted     Boolean
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([consentType])
}

// ─── CMS: Services & Blog ───────────────────────────────────

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortName       String
  metaTitle       String
  metaDescription String
  h1              String
  introParagraph  String   @db.Text
  problemQuestion String
  problemAnswer   String   @db.Text
  features        Json
  faq             Json
  serviceType     String
  priceRange      String   @default("$$$")
  coverImageUrl   String
  coverImageAlt   String
  videoUrl        String?
  category        String   @default("video")
  sortOrder       Int      @default(0)
  iconName        String?
  teamMembers     String[] @default([])
  deliverables    Json?
  equipment       Json?
  zoneText        String?  @db.Text
  relatedSlugs    String[] @default([])
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  relatedArticles BlogPost[] @relation("ServiceArticles")

  @@index([slug])
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String
  content         String         @default("") @db.Text
  status          BlogPostStatus @default(DRAFT)
  coverImageUrl   String?
  coverImageAlt   String?
  readingTimeMin  Int            @default(5)
  metaTitle       String?
  metaDescription String?
  tags            String[]       @default([])
  publishedAt     DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt @default(now())

  author          User?          @relation("BlogAuthor", fields: [authorId], references: [id])
  authorId        String?
  parentService   Service?       @relation("ServiceArticles", fields: [parentServiceId], references: [id])
  parentServiceId String?
  categories      BlogCategory[] @relation("PostCategories")

  @@index([parentServiceId])
  @@index([authorId])
  @@index([status])
}

model BlogCategory {
  id    String     @id @default(cuid())
  slug  String     @unique
  name  String
  color String?
  posts BlogPost[] @relation("PostCategories")

  @@index([slug])
}
