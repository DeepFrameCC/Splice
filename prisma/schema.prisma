generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  CLIENT
  TEAM
  ADMIN
}

enum Founder {
  LOUISIA
  TY
}

enum MediaType {
  PHOTO
  VIDEO
}

enum DevisStatus {
  ATTENTE
  VALIDE
  REFUSE
  PAYE
  ABONNE
}

enum AbonnementStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum FactureStatus {
  EMISE
  PAYEE
  ANNULEE
}

enum ContratStatus {
  A_VENIR
  EN_COURS
  FINI
}

enum CounterType {
  DEVIS
  FACTURE
  CONTRAT
}

enum DevisType {
  ABONNEMENT
  PACK_PARTICULIER
  FORMULE_BIENVENUE
}

enum DureeTournage {
  DEMI_JOURNEE
  JOURNEE
  DEUX_JOURNEES
}

enum UsageType {
  ORGANIQUE
  ADS_SOCIAL
  ADS_GOOGLE
}

enum DelaiLivraison {
  STANDARD
  ETENDU
  EXPRESS_48H
}

enum VilleDepart {
  TOURS
  ORLEANS
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_VERIFIED
  DEVIS_CREATED
  DEVIS_UPDATED
  DEVIS_DELETED
  FACTURE_CREATED
  CONTRAT_CREATED
  CONTRAT_UPDATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELED
  ADMIN_ACTION
  SETTINGS_UPDATED
  CONSENT_UPDATED
  LIVRAISON_UPLOADED
  LIVRAISON_DOWNLOADED
  LIVRAISON_DELETED
}

enum NotificationType {
  DEVIS_STATUS
  FACTURE_EMISE
  CONTRAT_SIGNE
  PAYMENT_CONFIRM
  LIVRAISON_PRETE
  SYSTEM
}

enum ConsentType {
  COOKIES_ESSENTIELS
  COOKIES_ANALYTICS
  NEWSLETTER
  DONNEES_PERSONNELLES
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── Portail Local — Enums ──────────────────────────────────
// Annuaire commerces + agenda + guides, multi-villes/regions.
// Statuts dédiés (spec) : BlogPostStatus n'est pas réutilisé pour éviter
// un couplage sémantique blog↔annuaire.

enum PlaceStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
}

enum PlaceSource {
  IMPORTED
  CLAIMED
  MANUAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum GuideStatus {
  DRAFT
  PUBLISHED
}

// ─── User & Auth ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(CLIENT)
  pseudo        String    @unique
  emailVerified DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  // Invalide les JWT émis avant un reset/changement de mot de passe (cf. requireActiveUser).
  passwordChangedAt DateTime?
  hasUsedFormuleBienvenue Boolean @default(false)
  stripeCustomerId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  sessions      Session[]
  likes         Like[]
  devis         Devis[]
  factures      Facture[]
  contrats      Contrat[]
  abonnements   Abonnement[]
  mediasMontes  Media[]        @relation("Monteur")
  auditLogs     AuditLog[]
  notifications Notification[]
  consents      ConsentLog[]
  reviews       Review[]
  blogPosts     BlogPost[] @relation("BlogAuthor")
  livraisons    Livraison[]
  // Portail Local : fiches d'annuaire revendiquées/possédées par cet utilisateur
  // (commerçant ayant réclamé sa fiche). Relation inverse de Place.ownerUserId.
  places        Place[]        @relation("PlaceOwner")

  @@index([email])
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  prenom        String?
  nom           String?
  nomEntreprise String?
  adresse       String?
  codePostal    String?
  ville         String?
  pays          String  @default("France")
  tel           String?
  age           Int?
  avatarUrl     String?
  bio           String?

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ─── Media & Gallery ────────────────────────────────────────

model Media {
  id           String    @id @default(cuid())
  type         MediaType
  url          String
  thumbnailUrl String?
  previewUrl   String?
  title        String
  description  String?
  materiel     String[]
  prixEstime   Int
  owner        Founder
  category     String?
  client       String?
  duration     String?
  monteurId    String?
  monteur      User?     @relation("Monteur", fields: [monteurId], references: [id])
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  groupKey     String?
  groupOrder   Int?
  // Portail Local : rattache (optionnellement) un média à une fiche d'annuaire.
  // Nullable + onDelete SetNull → 100% non-cassant pour la galerie existante,
  // et calqué sur le pattern monteurId/monteur déjà présent ci-dessus.
  placeId      String?
  place        Place?    @relation("PlaceMedias", fields: [placeId], references: [id], onDelete: SetNull)

  likes        Like[]

  @@index([groupKey])
  @@index([category])
  @@index([placeId])
}

model Like {
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
}

// ─── Business: Devis, Facture, Contrat ──────────────────────

model Counter {
  annee        Int
  type         CounterType
  lastSequence Int         @default(0)

  @@id([annee, type])
}

model Devis {
  id              String         @id @default(cuid())
  numero          String         @unique
  annee           Int
  sequence        Int
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  status          DevisStatus    @default(ATTENTE)
  chefDeProjet    Founder
  devisType       DevisType      @default(PACK_PARTICULIER)
  pack            String
  planAbonnement  String?
  billingCycle    String?
  duree           DureeTournage  @default(DEMI_JOURNEE)
  usage           UsageType      @default(ORGANIQUE)
  delai           DelaiLivraison @default(STANDARD)
  villeDepart     VilleDepart    @default(TOURS)
  distanceKm      Int            @default(0)
  videosSupp      Int            @default(0)
  videos3D        Int            @default(0)
  motionDesign    Boolean        @default(false)
  montageExpress  Boolean        @default(false)
  introAnimeeSec  Int?
  nbFormat916     Int            @default(0)
  nbFormat169     Int            @default(0)
  nomEntreprise   String
  nomContact      String
  emailContact    String
  telContact      String
  lieuTournage    String
  dateTournage    DateTime?
  remarques       String?
  lines           Json
  totalHT         Int
  acompteRate     Int            @default(30)
  acompteAmount   Int
  acomptePaid     Boolean        @default(false)
  pdfUrl          String?
  stripeSession   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  facture         Facture?
  contrat         Contrat?
  abonnement      Abonnement?
  livraisons      Livraison[]
}

// ─── Livraisons (fichiers finaux remis au client via R2) ────
// Métadonnées des objets stockés dans le bucket SPLICE_DELIVERIES.
// Le binaire vit dans R2 ; la clé r2Key est préfixée par {userId}/ pour que
// la route /api/deliveries/[...key] applique son ownership check (anti-IDOR).
model Livraison {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devisId     String?
  devis       Devis?   @relation(fields: [devisId], references: [id], onDelete: SetNull)
  titre       String
  description String?
  r2Key       String   @unique
  fileName    String
  contentType String
  taille      Int      // octets
  uploadedBy  String?  // id de l'admin/team ayant déposé le fichier
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([devisId])
}

model Abonnement {
  id                   String           @id @default(cuid())
  devisId              String           @unique
  devis                Devis            @relation(fields: [devisId], references: [id])
  userId               String
  user                 User             @relation(fields: [userId], references: [id])
  stripeSubscriptionId String           @unique
  stripeCustomerId     String
  plan                 String           // PlanId : STANDARD | PRO | PREMIUM_ABO
  billingCycle         String           // MENSUEL | ANNUEL | SANS_ENGAGEMENT
  status               AbonnementStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  // MENSUEL uniquement : terme de l'engagement minimum (début + ENGAGEMENT_MOIS).
  // Avant cette date, la résiliation est programmée au terme de l'engagement, pas
  // à la fin du mois courant. Null pour ANNUEL/SANS_ENGAGEMENT (aucun blocage).
  engagementEndsAt     DateTime?
  // Date de résiliation programmée quand on utilise Stripe `cancel_at` (résiliation
  // dans l'engagement). Null quand la fin suit la période courante (cancel_at_period_end).
  cancelAt             DateTime?
  factures             Facture[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Facture {
  id              String        @id @default(cuid())
  numero          String        @unique
  // devisId reste @unique mais devient optionnel : une facture ponctuelle garde
  // son devis (1:1, findUnique({where:{devisId}}) intact) ; une facture de cycle
  // d'abonnement a devisId = null (Postgres autorise plusieurs NULL en index
  // unique) et s'attache à l'abonnement via abonnementId (1:N).
  devisId         String?       @unique
  devis           Devis?        @relation(fields: [devisId], references: [id])
  abonnementId    String?
  abonnement      Abonnement?   @relation(fields: [abonnementId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          FactureStatus @default(EMISE)
  // montant propre à CETTE facture (null = dériver de Devis.totalHT, legacy ponctuel).
  montant         Int?
  periodeDebut    DateTime?
  periodeFin      DateTime?
  stripeInvoiceId String?       @unique
  pdfUrl          String?
  createdAt       DateTime      @default(now())
}

model Contrat {
  id        String        @id @default(cuid())
  numero    String        @unique
  annee     Int
  sequence  Int
  devisId   String        @unique
  devis     Devis         @relation(fields: [devisId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  status    ContratStatus @default(A_VENIR)
  pdfUrl    String?
  dateDebut DateTime?
  dateFin   DateTime?
  createdAt DateTime      @default(now())
}

// ─── Reviews & Avis ─────────────────────────────────────────

model Avis {
  id         String   @id @default(cuid())
  auteurNom  String
  contenu    String
  note       Int
  approuve   Boolean  @default(false)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contenu   String   @db.Text
  note      Int
  approuve  Boolean  @default(false)
  reponse   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Audit & Security ───────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  target    String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Notifications ──────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  href      String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ─── RGPD Consent Tracking ──────────────────────────────────

model ConsentLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  consentType ConsentType
  granted     Boolean
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([consentType])
}

// ─── CMS: Services & Blog ───────────────────────────────────

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortName       String
  metaTitle       String
  metaDescription String
  h1              String
  introParagraph  String   @db.Text
  problemQuestion String
  problemAnswer   String   @db.Text
  features        Json
  faq             Json
  serviceType     String
  priceRange      String   @default("$$$")
  coverImageUrl   String
  coverImageAlt   String
  videoUrl        String?
  category        String   @default("video")
  sortOrder       Int      @default(0)
  iconName        String?
  teamMembers     String[] @default([])
  deliverables    Json?
  equipment       Json?
  zoneText        String?  @db.Text
  relatedSlugs    String[] @default([])
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  relatedArticles BlogPost[] @relation("ServiceArticles")

  @@index([slug])
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String
  content         String         @default("") @db.Text
  status          BlogPostStatus @default(DRAFT)
  coverImageUrl   String?
  coverImageAlt   String?
  readingTimeMin  Int            @default(5)
  metaTitle       String?
  metaDescription String?
  tags            String[]       @default([])
  publishedAt     DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt @default(now())

  author          User?          @relation("BlogAuthor", fields: [authorId], references: [id])
  authorId        String?
  parentService   Service?       @relation("ServiceArticles", fields: [parentServiceId], references: [id])
  parentServiceId String?
  categories      BlogCategory[] @relation("PostCategories")

  @@index([parentServiceId])
  @@index([authorId])
  @@index([status])
}

model BlogCategory {
  id    String     @id @default(cuid())
  slug  String     @unique
  name  String
  color String?
  posts BlogPost[] @relation("PostCategories")

  @@index([slug])
}

// ─── Portail Local — Annuaire / Agenda / Guides ─────────────
// Bloc 100% additif. La géographie est de la DONNÉE (Region > City > District),
// jamais codée en dur : ajouter une ville/région = insérer des lignes, pas du code.

// Region : entité géographique racine (ex. "Centre-Val de Loire", code "CVL").
model Region {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String   @unique // code court (ex "CVL")
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// City : ville du portail. Contenu SEO unique par ville (heroText/introText).
// slug unique PAR région (une même ville peut exister sous plusieurs régions).
model City {
  id             String     @id @default(cuid())
  name           String
  slug           String
  departmentCode String     // ex "45"
  regionId       String
  region         Region     @relation(fields: [regionId], references: [id])
  lat            Float?
  lng            Float?
  heroText       String?    @db.Text
  introText      String?    @db.Text
  districts      District[]
  places         Place[]
  events         Event[]
  guides         Guide[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([regionId, slug])
  @@index([regionId])
  @@index([departmentCode])
}

// District : quartier d'une ville. slug unique par ville.
model District {
  id        String   @id @default(cuid())
  name      String
  slug      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  places    Place[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, slug])
  @@index([cityId])
}

// Category : taxonomie des commerces, indépendante de la géo et hiérarchisable
// (parentId self-relation → sous-catégories). Reliée aux Place via PlaceCategory.
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  icon        String?
  description String?     @db.Text
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  places      PlaceCategory[]
  guides      Guide[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

// Place : commerce / établissement de l'annuaire. slug unique PAR ville.
model Place {
  id          String       @id @default(cuid())
  name        String
  slug        String
  cityId      String
  city        City         @relation(fields: [cityId], references: [id])
  districtId  String?
  district    District?    @relation(fields: [districtId], references: [id], onDelete: SetNull)
  description String?      @db.Text
  address     String
  lat         Float?
  lng         Float?
  phone       String?
  website     String?
  email       String?
  horaires    Json?        // structure d'horaires libre (par jour / créneaux)
  status      PlaceStatus  @default(DRAFT)
  source      PlaceSource  @default(IMPORTED)
  ownerUserId String?      // commerçant ayant revendiqué la fiche
  owner       User?        @relation("PlaceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  premium     Boolean      @default(false)
  categories  PlaceCategory[]
  medias      Media[]      @relation("PlaceMedias")
  events      Event[]      @relation("EventVenue")
  guides      Guide[]      @relation("GuidePlaces")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([cityId, slug])
  @@index([cityId, status])
  @@index([status])
  @@index([ownerUserId])
}

// PlaceCategory : table de liaison explicite Place↔Category.
// Choix d'un join EXPLICITE (vs m-n implicite) pour porter `isPrimary` :
// une fiche a une catégorie principale (URL/breadcrumb/silo SEO) + des secondaires.
model PlaceCategory {
  placeId    String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@id([placeId, categoryId])
  @@index([categoryId])
}

// Event : agenda local. Peut se tenir dans une Place (venue) ou non.
// slug unique par ville pour un routage propre.
model Event {
  id           String      @id @default(cuid())
  title        String
  slug         String
  cityId       String
  city         City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  venuePlaceId String?
  venuePlace   Place?      @relation("EventVenue", fields: [venuePlaceId], references: [id], onDelete: SetNull)
  startAt      DateTime
  endAt        DateTime?
  description  String?     @db.Text
  category     String?     // libellé libre (ex "Concert", "Marché") — distinct de Category commerce
  coverUrl     String?     // URL R2 (même convention que BlogPost.coverImageUrl)
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([cityId, slug])
  @@index([cityId, startAt])
  @@index([status])
  @@index([venuePlaceId])
}

// Guide : article evergreen ("meilleurs X à <ville>"). Contenu HTML en @db.Text,
// même convention que BlogPost.content. slug unique par ville.
model Guide {
  id             String      @id @default(cuid())
  title          String
  slug           String
  cityId         String
  city           City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  excerpt        String?
  body           String      @default("") @db.Text
  coverUrl       String?     // URL R2 (même convention que BlogPost.coverImageUrl)
  status         GuideStatus @default(DRAFT)
  publishedAt    DateTime?
  placesFeatured Place[]     @relation("GuidePlaces")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([cityId, slug])
  @@index([cityId, status])
  @@index([categoryId])
}
