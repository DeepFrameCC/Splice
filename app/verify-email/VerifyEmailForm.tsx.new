"use client";

import { useTransition } from "react";

interface Props {
  token: string;
  action: (token: string) => Promise<void>;
}

export default function VerifyEmailForm({ token, action }: Props) {
  const [pending, startTransition] = useTransition();

  return (
    <form
      onSubmit={(e) => {
        e.preventDefault();
        startTransition(() => {
          action(token);
        });
      }}
      className="mt-6"
    >
      <button
        type="submit"
        disabled={pending}
        className="inline-flex rounded-xl bg-df-gold px-6 py-3 text-sm font-bold text-white shadow-lg shadow-df-gold/25 transition hover:bg-df-gold/90 disabled:opacity-60"
      >
        {pending ? "Vérification..." : "Confirmer mon email"}
      </button>
    </form>
  );
}
