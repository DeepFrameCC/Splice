# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/deepframe"

# ── Auth (NextAuth v5) ────────────────────────────────────
AUTH_SECRET="changeme-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=""
MAIL_FROM="Deepframe <contact@deepframe.cc>"
MAIL_FOUNDERS="papi@deepframe.cc,louisia@deepframe.cc,ty@deepframe.cc"

# ── Payments (Stripe) ────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── File Storage (Cloudflare R2) ─────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="deepframe"
R2_PUBLIC_URL=""

# ── Rate Limiting (Upstash Redis) ────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Encryption (AES-256-GCM for PII) ────────────────────
ENCRYPTION_KEY=""

# ── reCAPTCHA ────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ── Seed / Scripts ──────────────────────────────────────
ADMIN_SEED_PASSWORD=""              # Required for prisma/seed.ts
ADMIN_SEED_EMAIL="admin@deepframe.cc"
ADMIN_RESET_PASSWORD=""             # Required for scripts/reset-admin.ts

# ── Analytics (Plausible) ───────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ── Database (Direct connection for migrations) ─────────
DIRECT_URL=""
